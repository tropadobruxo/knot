generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum RoleType {
  dom
  sub
  switch
  exploring
}

enum IntentType {
  relacionamento
  amizade
  aprender
  casual
}

enum PhotoVisibility {
  public
  afterMatch
  private
}

enum PremiumTier {
  free
  plus
}

enum UserStatus {
  active
  suspended
  banned
}

enum EventType {
  munch
  workshop
  festa
}

enum RsvpStatus {
  confirmed
  waitlisted
  cancelled
}

enum ReportStatus {
  pending
  reviewed
  actioned
  dismissed
}

enum ModerationAction {
  warn
  suspend
  ban
}

enum SubscriptionStatus {
  active
  cancelled
  expired
}

enum PostModerationStatus {
  approved
  pending
  rejected
}

enum SelfieVerificationStatus {
  pending
  approved
  rejected
}

// ──────────────────────────────────────────────
// Core: User
// ──────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  username          String    @unique
  email             String    @unique
  emailVerified     DateTime?
  hashedPassword    String?
  image             String?

  // Age verification — only boolean + token, never documents
  ageVerified       Boolean   @default(false)
  ageVerifiedAt     DateTime?
  verificationToken String?

  // Selfie verification
  selfieVerified    Boolean   @default(false)
  selfieVerifiedAt  DateTime?

  // Travel mode
  travelCity        String?
  travelUntil       DateTime?

  // Profile
  roleType          RoleType?
  intent            IntentType[]
  bio               String?
  city              String?
  approxLat         Float?
  approxLng         Float?

  // Settings
  role              String       @default("user") // user | moderator | admin
  premiumTier       PremiumTier  @default(free)
  discreetMode      Boolean      @default(false)
  status            UserStatus   @default(active)
  stripeCustomerId  String?      @unique

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  lastActive        DateTime     @default(now())

  // Auth.js
  accounts          Account[]
  sessions          Session[]

  // Relations
  interests         UserInterest[]
  limits            Limit[]
  photos            Photo[]

  likesGiven        Like[]          @relation("LikesGiven")
  likesReceived     Like[]          @relation("LikesReceived")
  matchesAsA        Match[]         @relation("MatchUserA")
  matchesAsB        Match[]         @relation("MatchUserB")

  messages          Message[]
  groups            GroupMember[]
  posts             Post[]
  comments          Comment[]

  organizer         Organizer?
  eventsOrganized   Event[]         @relation("EventOrganizer")
  rsvps             Rsvp[]

  reportsCreated    Report[]        @relation("ReportCreator")
  reportsReceived   Report[]        @relation("ReportTarget")
  blocksCreated     Block[]         @relation("BlockCreator")
  blocksReceived    Block[]         @relation("BlockTarget")
  moderationLogs    ModerationLog[] @relation("ModeratedUser")

  subscription      Subscription?

  codeOfConductAcceptedAt DateTime?

  pushSubscriptions    PushSubscription[]
  reactions            Reaction[]
  stories              Story[]
  eventComments        EventComment[]
  groupMessages        GroupMessage[]
  selfieVerifications  SelfieVerification[]

  @@index([city])
  @@index([status])
}

// ──────────────────────────────────────────────
// Auth.js models
// ──────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ──────────────────────────────────────────────
// Profile: Interests & Limits
// ──────────────────────────────────────────────

model Interest {
  id        String         @id @default(cuid())
  name      String         @unique
  category  String?
  users     UserInterest[]
}

model UserInterest {
  id         String   @id @default(cuid())
  userId     String
  interestId String
  level      String?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
}

model Limit {
  id          String @id @default(cuid())
  userId      String
  description String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────────
// Photos
// ──────────────────────────────────────────────

model Photo {
  id         String          @id @default(cuid())
  userId     String
  url        String
  visibility PhotoVisibility @default(public)
  verified   Boolean         @default(false)
  order      Int             @default(0)
  createdAt  DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────────
// Discovery: Likes & Matches
// ──────────────────────────────────────────────

model Like {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  createdAt  DateTime @default(now())

  fromUser User @relation("LikesGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("LikesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
}

model Match {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA        User          @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User          @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([userAId, userBId])
}

// ──────────────────────────────────────────────
// Messaging
// ──────────────────────────────────────────────

model Conversation {
  id        String    @id @default(cuid())
  matchId   String    @unique
  createdAt DateTime  @default(now())

  match    Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions    Reaction[]

  @@index([conversationId, createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ──────────────────────────────────────────────
// Community: Groups, Posts, Comments
// ──────────────────────────────────────────────

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  city        String?
  moderated   Boolean  @default(true)
  createdAt   DateTime @default(now())

  members       GroupMember[]
  posts         Post[]
  groupMessages GroupMessage[]

  @@index([city])
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Post {
  id               String               @id @default(cuid())
  groupId          String
  authorId         String
  title            String
  content          String
  moderationStatus PostModerationStatus @default(pending)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([groupId, createdAt])
}

model Comment {
  id               String               @id @default(cuid())
  postId           String
  authorId         String
  content          String
  moderationStatus PostModerationStatus @default(pending)
  createdAt        DateTime             @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

// ──────────────────────────────────────────────
// Events
// ──────────────────────────────────────────────

model Event {
  id                    String    @id @default(cuid())
  type                  EventType
  title                 String
  description           String?
  organizerId           String
  city                  String
  venue                 String?
  datetime              DateTime
  priceCents            Int       @default(0)
  capacity              Int?
  safetyInfo            String?
  codeOfConductRequired Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organizer     User           @relation("EventOrganizer", fields: [organizerId], references: [id])
  rsvps         Rsvp[]
  eventComments EventComment[]

  @@index([city, datetime])
}

model Rsvp {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RsvpStatus @default(confirmed)
  createdAt DateTime   @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ──────────────────────────────────────────────
// Organizer (verified profile)
// ──────────────────────────────────────────────

model Organizer {
  id         String    @id @default(cuid())
  userId     String    @unique
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  bio        String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// Trust & Safety: Reports, Blocks, Moderation
// ──────────────────────────────────────────────

model Report {
  id         String       @id @default(cuid())
  creatorId  String
  targetId   String
  targetType String
  reason     String
  details    String?
  status     ReportStatus @default(pending)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  creator User @relation("ReportCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  target  User @relation("ReportTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Block {
  id        String   @id @default(cuid())
  creatorId String
  targetId  String
  createdAt DateTime @default(now())

  creator User @relation("BlockCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  target  User @relation("BlockTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([creatorId, targetId])
}

model ModerationLog {
  id        String           @id @default(cuid())
  userId    String
  action    ModerationAction
  reason    String
  createdAt DateTime         @default(now())

  user User @relation("ModeratedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────────
// Push Notifications
// ──────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ──────────────────────────────────────────────
// Stories (ephemeral 24h content)
// ──────────────────────────────────────────────

model Story {
  id        String   @id @default(cuid())
  authorId  String
  content   String
  imageUrl  String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────
// Event Comments
// ──────────────────────────────────────────────

model EventComment {
  id        String   @id @default(cuid())
  eventId   String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  event  Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
}

// ──────────────────────────────────────────────
// Billing: Subscription
// ──────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tier                 PremiumTier        @default(plus)
  status               SubscriptionStatus @default(active)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────
// Selfie Verification
// ──────────────────────────────────────────────

model SelfieVerification {
  id         String                   @id @default(cuid())
  userId     String
  selfieUrl  String
  gesture    String
  status     SelfieVerificationStatus @default(pending)
  reviewNote String?
  createdAt  DateTime                 @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
